{
  "name": "kalinar-agent-galaxy-os",
  "version": "1.0.1",
  "private": true,
  "main": "dist-electron/electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "desktop:dev": "vite",
    "desktop:build": "npm run build && npm run build:electron",
    "desktop:dist": "npm run desktop:build && electron-builder --win",
    "test": "vitest run",
    "start": "electron dist-electron/electron/main.js"
  },
  "dependencies": {
    "@gorules/zen-engine": "^2.1.9",
    "chokidar": "^4.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.187.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^3.0.2"
  }
}
